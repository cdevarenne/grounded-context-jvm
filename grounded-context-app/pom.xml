<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.cdevarenne</groupId>
    <artifactId>grounded-context-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>grounded-context-app</artifactId>
  <name>grounded-context app (Spring Boot)</name>
  <description>
    Everything the core deliberately excludes: the CLI, the Elasticsearch hybrid path, the
    MCP server, the eval harness. Depends on the core; the core never depends on this.
  </description>

  <properties>
    <spring-boot.version>4.1.0</spring-boot.version>
    <elasticsearch.version>9.5.1</elasticsearch.version>
    <picocli.version>4.7.7</picocli.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.cdevarenne</groupId>
      <artifactId>grounded-context-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>co.elastic.clients</groupId>
      <artifactId>elasticsearch-java</artifactId>
      <version>${elasticsearch.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli-spring-boot-starter</artifactId>
      <version>${picocli.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>io.github.cdevarenne.gctx.app.GroundedContextApplication</mainClass>
          <!-- The CLI is the product; `gctx` is what the README tells people to run. -->
          <finalName>gctx</finalName>
        </configuration>
        <executions>
          <execution>
            <!-- Not inherited: this project imports spring-boot-dependencies rather than
                 using spring-boot-starter-parent, so the repackage goal must be bound here. -->
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
